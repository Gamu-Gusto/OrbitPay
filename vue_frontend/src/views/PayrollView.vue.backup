<template>
  <div class="payroll-layout">
    <!-- Sidebar -->
    <AppSidebar :active-section="activeSection" @navigate="handleSidebarNav" />

    <!-- Main Content Area -->
    <main class="main-content">
      <!-- Page Header -->
      <div class="page-header">
        <div class="header-left">
          <h1 class="page-title">Payroll Processing</h1>
          <div class="breadcrumb">
            <span>Payroll</span>
            <span class="separator">/</span>
            <span>Process Pay Run</span>
          </div>
        </div>
        <div class="header-right">
          <button
            @click="calculatePayroll"
            :disabled="isCalculating"
            class="btn-primary"
          >
            <svg v-if="isCalculating" class="animate-spin -ml-1 mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            {{ isCalculating ? 'Calculating...' : 'Calculate Payroll' }}
          </button>
        </div>
      </div>

      <!-- Metric Cards -->
      <div class="metric-cards" v-if="calculatedData">
        <MetricCard label="Gross Pay" :value="calculatedData.total_earnings" />
        <MetricCard label="Deductions" :value="calculatedData.total_deductions" />
        <MetricCard label="Net Pay" :value="calculatedData.net_pay" type="success" />
      </div>

      <!-- Tabs -->
      <div class="tabs-underline">
        <button
          v-for="tab in tabs"
          :key="tab.id"
          @click="activeTab = tab.id"
          class="tab-underline"
          :class="{ active: activeTab === tab.id }"
        >
          {{ tab.name }}
        </button>
      </div>

      <!-- Details Tab -->
      <div v-if="activeTab === 'details'" class="fade-in tab-content">
        <div class="form-layout">
          <!-- Left Column - Forms -->
          <div class="form-column">
            <!-- Import Saved Company & Employee -->
            <FormSection title="Import Saved Company & Employee" icon="import">
              <div class="form-row-3">
                <div class="form-group span-2">
                  <label class="form-label">Company</label>
                  <select v-model.number="selectedCompanyId" @change="onCompanyChange" class="form-input">
                    <option :value="0">Select company</option>
                    <option v-for="c in companies" :key="c.id" :value="c.id">{{ c.name }}</option>
                  </select>
                </div>
                <div class="form-group">
                  <button @click="applyCompany" :disabled="!selectedCompanyId" class="btn-secondary w-full">Load Company</button>
                </div>
              </div>
              <div class="form-row-3">
                <div class="form-group span-2">
                  <label class="form-label">Employee</label>
                  <select v-model.number="selectedEmployeeId" class="form-input" :disabled="!selectedCompanyId || employees.length === 0">
                    <option :value="0">Select employee</option>
                    <option v-for="e in employees" :key="e.id" :value="e.id">{{ e.first_names }} {{ e.last_name }}</option>
                  </select>
                </div>
                <div class="form-group">
                  <button @click="applyEmployee" :disabled="!selectedEmployeeId" class="btn-secondary w-full">Load Employee</button>
                </div>
              </div>
            </FormSection>

            <!-- Employee Details Card -->
            <FormSection title="Employee Details" icon="user">
              <div class="form-group">
                <label class="form-label">First Names</label>
                <input v-model="formData.employee.first_names" type="text" class="form-input" placeholder="Enter first names" />
              </div>
              <div class="form-group">
                <label class="form-label">Last Name</label>
                <input v-model="formData.employee.last_name" type="text" class="form-input" placeholder="Enter last name" />
              </div>
              <div class="form-group">
                <label class="form-label">ID/Passport No.</label>
                <input v-model="formData.employee.id_no" type="text" class="form-input" placeholder="Enter ID or passport number" />
              </div>
              <div class="form-group">
                <label class="form-label">Employee No.</label>
                <input v-model="formData.employee.employee_no" type="text" class="form-input" placeholder="Enter employee number" />
              </div>
              <div class="form-group">
                <label class="form-label">Position</label>
                <input v-model="formData.employee.position" type="text" class="form-input" placeholder="Enter position" />
              </div>
              <div class="form-group">
                <label class="form-label">Tax Reference</label>
                <input v-model="formData.employee.tax_ref" type="text" class="form-input" placeholder="Enter tax reference" />
              </div>
              <div class="form-group span-2">
                <label class="form-label">Employment Date</label>
                <input v-model="formData.employee.emp_date" type="date" class="form-input" />
              </div>
            </FormSection>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">First Names</label>
                  <input
                    v-model="formData.employee.first_names"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter first names"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                  <input
                    v-model="formData.employee.last_name"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter last name"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">ID/Passport No.</label>
                  <input
                    v-model="formData.employee.id_no"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter ID or passport number"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Employee No.</label>
                  <input
                    v-model="formData.employee.employee_no"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter employee number"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Position</label>
                  <input
                    v-model="formData.employee.position"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter position"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Tax Reference</label>
                  <input
                    v-model="formData.employee.tax_ref"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter tax reference"
                  />
                </div>
                <div class="md:col-span-2">
                  <label class="block text-sm font-medium text-gray-700 mb-1">Employment Date</label>
                  <input
                    v-model="formData.employee.emp_date"
                    type="date"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                  />
                </div>
              </div>
            </div>

            <!-- Pay Period Card -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Pay Period
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Period Start</label>
                  <input
                    v-model="formData.period_start"
                    type="date"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Period End</label>
                  <input
                    v-model="formData.period_end"
                    type="date"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Payment Date</label>
                  <input
                    v-model="formData.payment_date"
                    type="date"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                  />
                </div>
              </div>
            </div>

            <!-- Calculation Mode Toggle -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
                </svg>
                Calculation Mode
              </h2>
              <div class="flex items-center justify-between">
                <div class="flex-1">
                  <p class="text-sm text-gray-600 mb-2">
                    {{ isReverseMode ? 'Calculate gross salary from desired net pay' : 'Calculate net pay from gross salary' }}
                  </p>
                  <div class="flex items-center space-x-3">
                    <span class="text-sm font-medium" :class="!isReverseMode ? 'text-gray-900' : 'text-gray-500'">Normal</span>
                    <button
                      @click="toggleCalculationMode"
                      class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors"
                      :class="isReverseMode ? 'bg-blue-600' : 'bg-gray-200'"
                    >
                      <span
                        class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform"
                        :class="isReverseMode ? 'translate-x-6' : 'translate-x-1'"
                      />
                    </button>
                    <span class="text-sm font-medium" :class="isReverseMode ? 'text-gray-900' : 'text-gray-500'">Reverse</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Earnings Card -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                </svg>
                {{ isReverseMode ? 'Net Pay Target' : 'Earnings (Monthly)' }}
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div v-if="!isReverseMode">
                  <label class="block text-sm font-medium text-gray-700 mb-1">Basic Pay</label>
                  <input
                    v-model.number="formData.basic_pay"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                </div>
                <div v-if="isReverseMode">
                  <label class="block text-sm font-medium text-gray-700 mb-1">Target Net Pay</label>
                  <input
                    v-model.number="formData.target_net_pay"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Other Earnings</label>
                  <input
                    v-model.number="formData.other_earnings"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                </div>
              </div>
              <div v-if="isReverseMode" class="mt-4 p-4 bg-blue-50 rounded-lg">
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-blue-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div>
                    <p class="text-sm text-blue-800 font-medium">Reverse Calculation Mode</p>
                    <p class="text-sm text-blue-700 mt-1">
                      Enter the desired net pay amount. The system will calculate the required gross salary 
                      to achieve this net amount after all deductions (PAYE, UIF, Pension, Medical Aid).
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Deductions Card -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                </svg>
                Deductions (Monthly)
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Pension/Retirement</label>
                  <input
                    v-model.number="formData.pension"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Medical Aid</label>
                  <input
                    v-model.number="formData.medical"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                </div>
              </div>
            </div>

            <!-- SDL Calculation Card -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
                Skills Development Levy (SDL)
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Annual Payroll</label>
                  <input
                    v-model.number="formData.annual_payroll"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                  <p class="text-xs text-gray-500 mt-1">Total annual payroll for SDL threshold check (R500,000+)</p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Excluded Amounts</label>
                  <input
                    v-model.number="formData.excluded_amounts"
                    type="number"
                    step="0.01"
                    min="0"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0.00"
                  />
                  <p class="text-xs text-gray-500 mt-1">Reimbursements, non-taxable allowances, retirement contributions</p>
                </div>
              </div>
              <div class="mt-4 p-4 bg-blue-50 rounded-lg">
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-blue-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div>
                    <p class="text-sm text-blue-800 font-medium">SDL Information</p>
                    <p class="text-sm text-blue-700 mt-1">
                      SDL is calculated at 1% of total remuneration, but only applies if your annual payroll exceeds R500,000.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Leave Income Card -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Leave Income
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Leave Days Taken</label>
                  <input
                    v-model.number="formData.leave_days_taken"
                    type="number"
                    min="0"
                    max="31"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="0"
                  />
                  <p class="text-xs text-gray-500 mt-1">Number of leave days taken in this period</p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Total Leave Days Available</label>
                  <input
                    v-model.number="formData.total_leave_days_available"
                    type="number"
                    min="0"
                    max="31"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="21"
                  />
                  <p class="text-xs text-gray-500 mt-1">Annual leave days available (default: 21 as per BCEA)</p>
                </div>
              </div>
              <div class="mt-4 p-4 bg-green-50 rounded-lg">
                <div class="flex items-start">
                  <svg class="w-5 h-5 text-green-600 mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div>
                    <p class="text-sm text-green-800 font-medium">Leave Income Calculation</p>
                    <p class="text-sm text-green-700 mt-1">
                      Leave income is calculated based on daily rates from annual salary. Only paid leave days within available limits are included.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Company Details Card -->
            <div class="card p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Company Details
              </h2>
              <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
                    <input
                      v-model="formData.company.company_name"
                      type="text"
                      class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                      placeholder="Enter company name"
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Registration No.</label>
                    <input
                      v-model="formData.company.company_reg_no"
                      type="text"
                      class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                      placeholder="Enter registration number"
                    />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
                  <textarea
                    v-model="formData.company.company_address"
                    rows="3"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter company address"
                  ></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">UIF Reference</label>
                    <input
                      v-model="formData.company.uif_ref"
                      type="text"
                      class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                      placeholder="UIF reference"
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                    <input
                      v-model="formData.company.phone"
                      type="tel"
                      class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                      placeholder="Phone number"
                    />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input
                      v-model="formData.company.email"
                      type="email"
                      class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                      placeholder="Email address"
                    />
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Run (e.g., June - 2025)</label>
                  <input
                    v-model="formData.company.run"
                    type="text"
                    class="form-input w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none"
                    placeholder="Enter payroll run identifier"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column - Summary & Actions -->
          <div class="space-y-6">
            <!-- Quick Summary Card -->
            <div class="card p-6 sticky top-4">
              <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Payroll Summary
              </h2>
              
              <div v-if="calculatedData" class="space-y-4">
                <div class="bg-green-50 p-4 rounded-lg border border-green-200">
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-medium text-green-800">Total Earnings</span>
                    <span class="text-lg font-bold text-green-900">R{{ formatCurrency(calculatedData.total_earnings) }}</span>
                  </div>
                </div>
                
                <div class="bg-red-50 p-4 rounded-lg border border-red-200">
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-medium text-red-800">Total Deductions</span>
                    <span class="text-lg font-bold text-red-900">R{{ formatCurrency(calculatedData.total_deductions) }}</span>
                  </div>
                  <div class="mt-2 space-y-1 text-xs text-red-700">
                    <div class="flex justify-between">
                      <span>PAYE:</span>
                      <span>R{{ formatCurrency(calculatedData.paye) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span>UIF:</span>
                      <span>R{{ formatCurrency(calculatedData.uif) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span>Pension:</span>
                      <span>R{{ formatCurrency(formData.pension) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span>Medical:</span>
                      <span>R{{ formatCurrency(formData.medical) }}</span>
                    </div>
                  </div>
                </div>
                
                <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
                  <div class="flex justify-between items-center">
                    <span class="text-sm font-medium text-blue-800">Net Pay</span>
                    <span class="text-xl font-bold text-blue-900">R{{ formatCurrency(calculatedData.net_pay) }}</span>
                  </div>
                </div>
              </div>

              <div v-else class="text-center py-8 text-gray-500">
                <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
                <p>Enter payroll details to see calculations</p>
              </div>

              <!-- Action Buttons -->
              <div class="mt-6 space-y-3">
                <div v-if="auth.roles.includes('client_admin') && selectedCompanyId && calculatedData">
                  <div class="flex space-x-2">
                    <button @click="approveRun" class="btn-primary flex-1">Approve Run</button>
                    <button @click="rejectRun" class="btn-secondary flex-1">Reject Run</button>
                  </div>
                </div>
                <button
                  @click="calculatePayroll"
                  :disabled="isCalculating"
                  class="btn-primary w-full flex items-center justify-center"
                >
                  <svg v-if="isCalculating" class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  {{ isCalculating ? 'Calculating...' : (isReverseMode ? 'Calculate Gross from Net' : 'Calculate Payroll') }}
                </button>
                
                <button
                  @click="generatePayslip"
                  :disabled="!calculatedData || isGeneratingPDF"
                  class="btn-secondary w-full flex items-center justify-center"
                  :class="{ 'opacity-50 cursor-not-allowed': !calculatedData || isGeneratingPDF }"
                >
                  <svg v-if="isGeneratingPDF" class="animate-spin -ml-1 mr-3 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <svg v-else class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  {{ isGeneratingPDF ? 'Generating...' : 'Generate Payslip PDF' }}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Summary Tab -->
      <div v-if="activeTab === 'summary'" class="fade-in">
        <div class="max-w-4xl mx-auto">
          <div v-if="calculatedData" class="space-y-6">
            <!-- Reverse Calculation Result -->
            <div v-if="isReverseMode && calculatedData.calculated_gross_pay" class="card p-6 bg-blue-50 border-blue-200">
              <h3 class="text-lg font-semibold text-blue-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Reverse Calculation Result
              </h3>
              <div class="bg-white p-4 rounded-lg border border-blue-200">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="text-center">
                    <p class="text-sm text-gray-600 mb-1">Target Net Pay</p>
                    <p class="text-2xl font-bold text-blue-700">R{{ formatCurrency(formData.target_net_pay) }}</p>
                  </div>
                  <div class="text-center">
                    <p class="text-sm text-gray-600 mb-1">Calculated Gross Pay</p>
                    <p class="text-2xl font-bold text-green-700">R{{ formatCurrency(calculatedData.calculated_gross_pay) }}</p>
                  </div>
                </div>
                <div class="mt-4 p-3 bg-blue-100 rounded-lg">
                  <p class="text-sm text-blue-800">
                    <strong>Result:</strong> To achieve a net pay of R{{ formatCurrency(formData.target_net_pay) }}, 
                    the employee needs a gross salary of R{{ formatCurrency(calculatedData.calculated_gross_pay) }}.
                  </p>
                </div>
              </div>
            </div>

            <!-- Detailed Breakdown -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Earnings Breakdown -->
              <div class="card p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                  <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                  </svg>
                  Earnings Breakdown
                </h3>
                <div class="space-y-3">
                  <div v-for="[description, amount] in calculatedData.earnings" :key="description" class="flex justify-between items-center py-2 border-b border-gray-100">
                    <span class="text-gray-700">{{ description }}</span>
                    <span class="font-medium text-green-700">R{{ formatCurrency(amount) }}</span>
                  </div>
                  <div class="flex justify-between items-center py-2 font-semibold text-lg border-t-2 border-green-200">
                    <span class="text-gray-900">Total Earnings</span>
                    <span class="text-green-700">R{{ formatCurrency(calculatedData.total_earnings) }}</span>
                  </div>
                </div>
              </div>

              <!-- Deductions Breakdown -->
              <div class="card p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
                  <svg class="w-5 h-5 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                  </svg>
                  Deductions Breakdown
                </h3>
                <div class="space-y-3">
                  <div v-for="[description, amount] in calculatedData.deductions" :key="description" class="flex justify-between items-center py-2 border-b border-gray-100">
                    <span class="text-gray-700">{{ description }}</span>
                    <span class="font-medium text-red-700">R{{ formatCurrency(amount) }}</span>
                  </div>
                  <div class="flex justify-between items-center py-2 font-semibold text-lg border-t-2 border-red-200">
                    <span class="text-gray-900">Total Deductions</span>
                    <span class="text-red-700">R{{ formatCurrency(calculatedData.total_deductions) }}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Net Pay Summary -->
            <div class="card p-8 text-center bg-gradient-to-r from-blue-50 to-indigo-50 border-blue-200">
              <h3 class="text-2xl font-bold text-gray-900 mb-2">Net Pay</h3>
              <p class="text-4xl font-bold text-blue-700 mb-4">R{{ formatCurrency(calculatedData.net_pay) }}</p>
              <p class="text-gray-600">
                For {{ formData.employee.first_names }} {{ formData.employee.last_name }}
              </p>
              <p class="text-sm text-gray-500 mt-2">
                Pay period: {{ formatDate(formData.period_start) }} to {{ formatDate(formData.period_end) }}
              </p>
            </div>

            <!-- SDL Details -->
            <div v-if="calculatedData.sdl_details && calculatedData.sdl > 0" class="card p-6 bg-blue-50 border-blue-200">
              <h3 class="text-lg font-semibold text-blue-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                </svg>
                Skills Development Levy (SDL) Details
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-white p-4 rounded-lg border border-blue-200">
                  <div class="space-y-2">
                    <div class="flex justify-between">
                      <span class="text-gray-600">SDL Amount:</span>
                      <span class="font-semibold text-blue-700">R{{ formatCurrency(calculatedData.sdl) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Total Remuneration:</span>
                      <span class="font-medium">R{{ formatCurrency(calculatedData.sdl_details.total_remuneration) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Excluded Amounts:</span>
                      <span class="font-medium">R{{ formatCurrency(calculatedData.sdl_details.excluded_amounts) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">SDL Rate:</span>
                      <span class="font-medium">{{ (calculatedData.sdl_details.sdl_rate * 100) }}%</span>
                    </div>
                  </div>
                </div>
                <div class="bg-white p-4 rounded-lg border border-blue-200">
                  <div class="space-y-2">
                    <div class="flex justify-between">
                      <span class="text-gray-600">Annual Payroll:</span>
                      <span class="font-medium">R{{ formatCurrency(calculatedData.sdl_details.annual_payroll) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Threshold:</span>
                      <span class="font-medium">R{{ formatCurrency(calculatedData.sdl_details.threshold_amount) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Exceeds Threshold:</span>
                      <span class="font-medium" :class="calculatedData.sdl_details.exceeds_threshold ? 'text-green-600' : 'text-red-600'">
                        {{ calculatedData.sdl_details.exceeds_threshold ? 'Yes' : 'No' }}
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Leave Income Details -->
            <div v-if="calculatedData.leave_income_details && calculatedData.leave_income > 0" class="card p-6 bg-green-50 border-green-200">
              <h3 class="text-lg font-semibold text-green-900 mb-4 flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Leave Income Details
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-white p-4 rounded-lg border border-green-200">
                  <div class="space-y-2">
                    <div class="flex justify-between">
                      <span class="text-gray-600">Leave Income:</span>
                      <span class="font-semibold text-green-700">R{{ formatCurrency(calculatedData.leave_income) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Daily Rate:</span>
                      <span class="font-medium">R{{ formatCurrency(calculatedData.leave_income_details.daily_rate) }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Leave Days Taken:</span>
                      <span class="font-medium">{{ calculatedData.leave_income_details.leave_days_taken }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Days Paid:</span>
                      <span class="font-medium">{{ calculatedData.leave_income_details.actual_leave_days_paid }}</span>
                    </div>
                  </div>
                </div>
                <div class="bg-white p-4 rounded-lg border border-green-200">
                  <div class="space-y-2">
                    <div class="flex justify-between">
                      <span class="text-gray-600">Available Days:</span>
                      <span class="font-medium">{{ calculatedData.leave_income_details.total_leave_days_available }}</span>
                    </div>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Working Days/Year:</span>
                      <span class="font-medium">{{ calculatedData.leave_income_details.working_days_per_year }}</span>
                    </div>
                    <div v-if="calculatedData.leave_income_details.exceeded_available_leave" class="flex justify-between">
                      <span class="text-gray-600">Unpaid Days:</span>
                      <span class="font-medium text-red-600">{{ calculatedData.leave_income_details.unpaid_leave_days }}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div v-else class="text-center py-16">
            <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-2">No calculations available</h3>
            <p class="text-gray-600 mb-6">Please go to the Details tab and calculate payroll first.</p>
            <button @click="activeTab = 'details'" class="btn-primary">
              Go to Details
            </button>
          </div>
        </div>
      </div>
    </main>
  </div>
</template>

<script>
import { ref, reactive, computed, onMounted } from 'vue'
import axios from 'axios'
import { useAuthStore } from '../stores/auth'

export default {
  name: 'PayrollView',
  setup() {
    const auth = useAuthStore()
    const activeTab = ref('details')
    const isDarkMode = ref(false)
    const isCalculating = ref(false)
    const isGeneratingPDF = ref(false)
    const calculatedData = ref(null)
    const isReverseMode = ref(false)

    const tabs = [
      { id: 'details', name: 'Details & Payslip' },
      { id: 'summary', name: 'Summary & Calculations' }
    ]

    const formData = reactive({
      employee: {
        first_names: '',
        last_name: '',
        id_no: '',
        employee_no: '',
        position: '',
        tax_ref: '',
        emp_date: new Date().toISOString().split('T')[0]
      },
      company: {
        company_name: 'Ditheto Accountants',
        company_reg_no: '',
        company_address: '',
        uif_ref: '',
        phone: '',
        email: '',
        run: ''
      },
      period_start: new Date().toISOString().split('T')[0],
      period_end: new Date().toISOString().split('T')[0],
      payment_date: new Date().toISOString().split('T')[0],
      basic_pay: 0,
      other_earnings: 0,
      pension: 0,
      medical: 0,
      target_net_pay: 0,
      // SDL calculation fields
      annual_payroll: 0,
      excluded_amounts: 0,
      // Leave income fields
      leave_days_taken: 0,
      total_leave_days_available: 21
    })

    const toggleTheme = () => {
      isDarkMode.value = !isDarkMode.value
    }

    const toggleCalculationMode = () => {
      isReverseMode.value = !isReverseMode.value
      // Clear calculated data when switching modes
      calculatedData.value = null
    }

    // ---------- Import data from backend ----------
    const API = ''
    const companies = ref([])
    const employees = ref([])
    const selectedCompanyId = ref(0)
    const selectedEmployeeId = ref(0)

    const loadCompanies = async () => {
      try {
        const { data } = await axios.get(`${API}/companies`)
        companies.value = data
      } catch (e) {
        console.error('Failed to load companies', e)
      }
    }

    const onCompanyChange = async () => {
      selectedEmployeeId.value = 0
      employees.value = []
      if (!selectedCompanyId.value) return
      try {
        const [companyRes, empsRes] = await Promise.all([
          axios.get(`${API}/companies/${selectedCompanyId.value}`),
          axios.get(`${API}/companies/${selectedCompanyId.value}/employees`)
        ])
        // Preload company list and employees for selection
        employees.value = empsRes.data
        // Optionally auto-apply company on select
        mapCompanyToForm(companyRes.data)
      } catch (e) {
        console.error('Failed to load company/employees', e)
      }
    }

    const applyCompany = async () => {
      if (!selectedCompanyId.value) return
      try {
        const { data } = await axios.get(`${API}/companies/${selectedCompanyId.value}`)
        mapCompanyToForm(data)
      } catch (e) {
        console.error('Failed to apply company', e)
      }
    }

    const applyEmployee = async () => {
      if (!selectedEmployeeId.value) return
      try {
        const { data } = await axios.get(`${API}/employees/${selectedEmployeeId.value}`)
        mapEmployeeToForm(data)
      } catch (e) {
        console.error('Failed to apply employee', e)
      }
    }

    const mapCompanyToForm = (c) => {
      formData.company.company_name = c?.name || ''
      formData.company.company_reg_no = c?.registration_number || ''
      formData.company.company_address = c?.address || ''
      formData.company.uif_ref = c?.uif_reference || ''
      formData.company.phone = c?.phone || ''
      formData.company.email = c?.email || ''
      // keep run as-is; it's per payroll run
    }

    const mapEmployeeToForm = (e) => {
      formData.employee.first_names = e?.first_names || ''
      formData.employee.last_name = e?.last_name || ''
      formData.employee.id_no = e?.id_no || ''
      formData.employee.employee_no = e?.employee_no || ''
      formData.employee.position = e?.position || ''
      formData.employee.tax_ref = e?.tax_ref || ''
      formData.employee.emp_date = e?.emp_date || new Date().toISOString().split('T')[0]
      formData.basic_pay = Number(e?.basic_salary ?? 0)
      const allowancesTotal = Number(e?.housing_allowance ?? 0) + Number(e?.transport_allowance ?? 0) + Number(e?.meal_allowance ?? 0) + Number(e?.other_allowances ?? 0)
      formData.other_earnings = allowancesTotal || 0
      formData.pension = Number(e?.pension_contribution ?? 0)
      formData.medical = Number(e?.medical_aid ?? 0)
    }

    const formatCurrency = (amount) => {
      return new Intl.NumberFormat('en-ZA', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(amount || 0)
    }

    const formatDate = (dateString) => {
      return new Date(dateString).toLocaleDateString('en-ZA', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      })
    }

    const calculatePayroll = async () => {
      isCalculating.value = true
      try {
        let response
        if (isReverseMode.value) {
          // Use reverse calculation endpoint
          const reverseData = {
            employee: formData.employee,
            company: formData.company,
            period_start: formData.period_start,
            period_end: formData.period_end,
            payment_date: formData.payment_date,
            target_net_pay: formData.target_net_pay,
            pension: formData.pension,
            medical: formData.medical,
            // SDL calculation fields
            annual_payroll: formData.annual_payroll,
            excluded_amounts: formData.excluded_amounts,
            // Leave income fields
            leave_days_taken: formData.leave_days_taken,
            total_leave_days_available: formData.total_leave_days_available
          }
          response = await axios.post('/calculate-reverse-payroll', reverseData)
          
          // Convert reverse result to standard PayslipData format for display
          const reverseResult = response.data
          calculatedData.value = {
            employee: reverseResult.employee,
            company: reverseResult.company,
            period_start: reverseResult.period_start,
            period_end: reverseResult.period_end,
            payment_date: reverseResult.payment_date,
            earnings: reverseResult.earnings,
            total_earnings: reverseResult.total_earnings,
            deductions: reverseResult.deductions,
            total_deductions: reverseResult.total_deductions,
            net_pay: reverseResult.net_pay,
            paye: reverseResult.paye,
            uif: reverseResult.uif,
            calculated_gross_pay: reverseResult.calculated_gross_pay, // Keep this for display
            sdl: reverseResult.sdl,
            leave_income: reverseResult.leave_income,
            sdl_details: reverseResult.sdl_details,
            leave_income_details: reverseResult.leave_income_details
          }
        } else {
          // Use normal calculation endpoint
          response = await axios.post('/calculate-payroll', formData)
          calculatedData.value = response.data
        }
      } catch (error) {
        console.error('Error calculating payroll:', error)
        let detail = error?.response?.data?.detail || error.message || 'Unknown error'
        // Handle array of validation errors
        if (Array.isArray(detail)) {
          detail = detail.map(e => e.msg || e).join('\n')
        }
        alert(`Error calculating payroll:\n${detail}`)
      } finally {
        isCalculating.value = false
      }
    }

    // Simple approval actions (create pending run then approve/reject)
    const approveRun = async () => {
      try {
        const { data: run } = await axios.post('/payroll-runs', {
          company_id: selectedCompanyId.value,
          period_start: formData.period_start,
          period_end: formData.period_end
        })
        await axios.post(`/payroll-runs/${run.id}/approve`)
        alert('Run approved')
      } catch (e) { alert('Approval failed') }
    }
    const rejectRun = async () => {
      try {
        const { data: run } = await axios.post('/payroll-runs', {
          company_id: selectedCompanyId.value,
          period_start: formData.period_start,
          period_end: formData.period_end
        })
        await axios.post(`/payroll-runs/${run.id}/reject`)
        alert('Run rejected')
      } catch (e) { alert('Reject failed') }
    }

    const generatePayslip = async () => {
      if (!calculatedData.value) return
      
      isGeneratingPDF.value = true
      try {
        const response = await axios.post('/generate-payslip', calculatedData.value, {
          responseType: 'blob'
        })
        
        // Create blob link to download
        const url = window.URL.createObjectURL(new Blob([response.data]))
        const link = document.createElement('a')
        link.href = url
        link.setAttribute('download', `payslip_${formData.employee.last_name}_${formData.employee.first_names}.pdf`)
        document.body.appendChild(link)
        link.click()
        link.remove()
        window.URL.revokeObjectURL(url)
      } catch (error) {
        console.error('Error generating payslip:', error)
        alert('Error generating payslip. Please try again.')
      } finally {
        isGeneratingPDF.value = false
      }
    }

    onMounted(() => {
      loadCompanies()
    })

    return {
      auth,
      activeTab,
      isDarkMode,
      isCalculating,
      isGeneratingPDF,
      calculatedData,
      isReverseMode,
      tabs,
      formData,
      companies,
      employees,
      selectedCompanyId,
      selectedEmployeeId,
      onCompanyChange,
      applyCompany,
      applyEmployee,
      approveRun,
      rejectRun,
      toggleTheme,
      toggleCalculationMode,
      formatCurrency,
      formatDate,
      calculatePayroll,
      generatePayslip
    }
  }
}
</script>
