# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL connection string (auto-set by Render when using render.yaml)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# JWT signing secret — use a long random string in production
# Render can auto-generate this via render.yaml (generateValue: true)
JWT_SECRET=change-me-to-a-long-random-secret

# The deployed frontend URL for CORS (e.g. https://payroll-frontend.onrender.com)
FRONTEND_URL=https://payroll-frontend.onrender.com
