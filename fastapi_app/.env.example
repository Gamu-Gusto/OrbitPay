# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL connection string (auto-set by Render when using render.yaml)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# JWT signing secret — use a long random string in production
# Render can auto-generate this via render.yaml (generateValue: true)
JWT_SECRET=change-me-to-a-long-random-secret

# The deployed frontend URL for CORS (e.g. https://payroll-frontend.onrender.com)
FRONTEND_URL=https://payroll-frontend.onrender.com

# One-time Super Admin setup secret (generate with: openssl rand -base64 32)
# Once setup is complete this is no longer needed but leave it set for safety
ADMIN_SETUP_SECRET=replace-with-openssl-rand-base64-32

# SMTP settings for transactional email (welcome emails, password resets)
# Leave blank to disable email sending (the app will still function without it)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
